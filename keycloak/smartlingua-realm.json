{
  "id": "smartlingua",
  "realm": "smartlingua",
  "displayName": "SmartLingua",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Platform administrator",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "TEACHER",
        "description": "Course teacher",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "STUDENT",
        "description": "Platform student",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "angular",
      "name": "Angular Frontend",
      "description": "SmartLingua Angular SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://192.168.56.10:4200/*"
      ],
      "webOrigins": ["http://localhost:4200", "http://192.168.56.10:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@smartlingua.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "teacher",
      "email": "teacher@smartlingua.com",
      "firstName": "Demo",
      "lastName": "Teacher",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "teacher123",
          "temporary": false
        }
      ],
      "realmRoles": ["TEACHER"]
    },
    {
      "username": "student",
      "email": "student@smartlingua.com",
      "firstName": "Demo",
      "lastName": "Student",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "student123",
          "temporary": false
        }
      ],
      "realmRoles": ["STUDENT"]
    }
  ]
}
